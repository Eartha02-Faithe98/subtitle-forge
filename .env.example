# Subtitle Forge Phase 1 local configuration
# Copy this file to .env for local overrides. Do not store real secrets here.

# Backend (FastAPI)
SUBTITLE_FORGE_HOST=127.0.0.1
SUBTITLE_FORGE_PORT=8000
SUBTITLE_FORGE_ENVIRONMENT=development
SUBTITLE_FORGE_ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
SUBTITLE_FORGE_DATA_ROOT=D:/path/to/subtitle-forge/runtime/data/jobs
SUBTITLE_FORGE_UPLOAD_MAX_BYTES=1073741824
SUBTITLE_FORGE_FFPROBE_TIMEOUT_SECONDS=30
SUBTITLE_FORGE_FFMPEG_TIMEOUT_SECONDS=600
SUBTITLE_FORGE_YOUTUBE_TIMEOUT_SECONDS=900

# Local Whisper
SUBTITLE_FORGE_WHISPER_MODELS={"fast":"base.en","balanced":"small.en","accurate":"medium.en"}
SUBTITLE_FORGE_WHISPER_DEVICE=cpu
SUBTITLE_FORGE_WHISPER_COMPUTE_TYPE=int8
SUBTITLE_FORGE_AUDIO_CHUNK_SECONDS=900
SUBTITLE_FORGE_AUDIO_CHUNK_OVERLAP_SECONDS=5

# Ollama-compatible local translation and summary provider
SUBTITLE_FORGE_OLLAMA_BASE_URL=http://127.0.0.1:11434
SUBTITLE_FORGE_OLLAMA_MODEL=qwen2.5:7b
SUBTITLE_FORGE_OLLAMA_TIMEOUT_SECONDS=180
SUBTITLE_FORGE_PROMPT_MAX_CHARS=12000

# Local job UI and retention
SUBTITLE_FORGE_POLL_INTERVAL_MS=1000
SUBTITLE_FORGE_RETENTION_HOURS=168

# Frontend (Next.js) - public, non-secret values only
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
FRONTEND_PORT=3000
