# Subtitle Forge Phase 0 configuration
# Copy this file to .env for local overrides. Do not store real secrets here.

# Backend (FastAPI)
SUBTITLE_FORGE_HOST=127.0.0.1
SUBTITLE_FORGE_PORT=8000
SUBTITLE_FORGE_ENVIRONMENT=development
SUBTITLE_FORGE_ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Frontend (Next.js) - public, non-secret values only
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
FRONTEND_PORT=3000
